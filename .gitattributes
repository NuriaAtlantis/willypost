# WillyPost - normalización de finales de línea y tipos de archivo.
# IMPORTANTE para que el instalador funcione cuando el alumno descarga el ZIP de GitHub:
#  - Windows (.bat, .vbs, .ps1) necesita CRLF. Los .ps1 se guardan en UTF-8 con BOM (para los acentos).
#  - macOS/Linux (.command, .sh) necesita LF (con CRLF el script falla con "bad interpreter").
#  - Los .command y los .sh DEBEN tener el bit de ejecución en git (los atributos no lo pueden fijar):
#      git update-index --chmod=+x "Instalar WillyPost.command" "Abrir WillyPost.command" "Desinstalar WillyPost.command"
#      git update-index --chmod=+x scripts/mac/*.sh
#    (Se hace una sola vez, justo después del primer "git add"; GitHub conserva el permiso en el ZIP.)
* text=auto

*.bat     text eol=crlf
*.cmd     text eol=crlf
*.vbs     text eol=crlf
*.ps1     text eol=crlf
*.sed     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.md      text eol=lf

*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.exe  binary

# La interfaz compilada va en el repo (el alumno no compila): que no ensucie los diffs
web/dist/** -diff linguist-generated=true
package-lock.json -diff
